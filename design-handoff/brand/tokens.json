{
  "color": {
    "ink": {
      "value": "#14243A",
      "use": "Text, marks, rules on dark"
    },
    "sailcloth": {
      "value": "#F4F1EA",
      "use": "Page ground"
    },
    "harbor-green": {
      "value": "#2E5B4B",
      "use": "Secondary: italic emphasis, links on hover, the Life section"
    },
    "signal": {
      "value": "#C8461B",
      "use": "Rare accent: index numbers, the T flag"
    },
    "flag-gold": {
      "value": "#E0A93B",
      "use": "Inside the flags only (D flag). Not for UI or text"
    },
    "slate": {
      "value": "#5A6270",
      "use": "Secondary text, captions, mono metadata"
    },
    "body-ink": {
      "value": "#3A4556",
      "use": "Long-form body text"
    },
    "rule": {
      "value": "#D9D3C5",
      "use": "Hairlines and borders"
    },
    "surface": {
      "value": "#FFFFFF",
      "use": "Cards, image mats"
    }
  },
  "font": {
    "display": {
      "family": "Newsreader",
      "weights": [
        400,
        500
      ],
      "italic": true,
      "use": "Wordmark, headlines, pull quotes"
    },
    "body": {
      "family": "Instrument Sans",
      "weights": [
        400,
        500,
        600
      ],
      "use": "Body, navigation, UI"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "use": "Index numbers, dates, coordinates. Uppercase, +0.1em tracking"
    }
  },
  "type-scale-px": {
    "display": 64,
    "h1": 48,
    "h2": 32,
    "h3": 24,
    "body-lg": 20,
    "body": 18,
    "small": 15,
    "mono-label": 13
  },
  "space-px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "radius-px": {
    "none": 0,
    "icon": 4
  },
  "rule-width-px": 1
}